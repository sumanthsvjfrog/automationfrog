// FROGBOT-STATE-CLEANER Pipeline Script

pipeline {
    agent any
    tools { 
        jfrog 'psblr' // Declares the jfrog CLI tool
    }

    triggers {
        // Runs once a day at 00:00 UTC (Midnight)
        cron('0 0 * * *') 
    }

    environment {
        SERVER_ID = 'psblr1'
        JFROG_REPO = 'frogbot-state'
        JFROG_STATE_PREFIX = 'state/repo-status/'
        JF_URL_CREDENTIAL_ID = 'JF_URL' 
        JF_ACCESS_TOKEN_ID = 'JF_ACCESS_TOKEN'
        CLEANUP_SCRIPT_NAME = 'reset_status.sh'
    }

    stages {
        stage('Checkout Script and Execute Cleanup') {
            steps {
                script {
                    // --- CONFIGURE JFROG CLI ---
                    echo "Configuring JFrog CLI server ID: ${env.SERVER_ID}."
                    
                    withCredentials([
                        string(credentialsId: env.JF_ACCESS_TOKEN_ID, variable: 'ACCESS_TOKEN'),
                        string(credentialsId: env.JF_URL_CREDENTIAL_ID, variable: 'JF_PLATFORM_URL')
                    ]) {
                        // Use sh command to execute configuration, passing variables via the shell env
                        sh """
                        echo "Adding jf cli server config..."
                        /usr/local/bin/jf c add ${env.SERVER_ID} \\
                          --url=\${JF_PLATFORM_URL} \\
                          --artifactory-url=\${JF_PLATFORM_URL}/artifactory \\
                          --access-token=\${ACCESS_TOKEN} \\
                          --overwrite=true
                         /usr/local/bin/jf c use ${env.SERVER_ID}
                        """
                         
                    }
                    
                    // --- Executing the script ---
                    echo "Starting status resetter script ."
                    sh "chmod +x ${env.CLEANUP_SCRIPT_NAME}" 

                    sh "./${env.CLEANUP_SCRIPT_NAME}"
                }
            }
        }
    }
}
