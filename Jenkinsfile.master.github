// FROGBOT-MASTER-SCHEDULER Pipeline Script (Finalized)

pipeline {
    agent any
    tools { 
        jfrog 'psblr'
    }

    triggers {
        cron('0 0 * * *')
    }
    parameters {
        string(
            name: 'GITHUB_OWNER', 
            defaultValue: 'sumanthsvjfrog',
            description: 'GitHub organization or user account to scan.'
        )
    }
    environment {
        GITHUB_API_URL = "https://api.github.com/users/${params.GITHUB_OWNER}/repos?per_page=100"
        
        // --- Artifacts & State ---
        REPO_LIST_FILE = 'all_repos.txt'
        JFROG_REPO = 'frogbot-state' 
        JFROG_STATE_PREFIX = 'state/repo-status/' 
    }

    stages {
        stage('1. Generate Repository List') {
            steps {
                script {
                    echo "Starting in-pipeline repository list generation from GitHub (Owner: ${params.GITHUB_OWNER})..."
                    withCredentials([string(credentialsId: 'JF_GIT_TOKEN', variable: 'GIT_PAT')]) {
                        sh """
                        > ${env.REPO_LIST_FILE}
                        PAGE=1
                        while true; do
                          URL="${env.GITHUB_API_URL}&page=\$PAGE"
                          JSON_RESPONSE=\$(curl -s -u '${params.GITHUB_OWNER}:\$GIT_PAT' "\$URL")
                          
                          if [ "\$(echo "\$JSON_RESPONSE" | jq 'length')" -eq 0 ]; then
                            break
                          fi
                            
                          echo "\$JSON_RESPONSE" | jq -r '.[] | .full_name' >> ${env.REPO_LIST_FILE}
                            
                          PAGE=\$((PAGE + 1))
                        done
                        echo "Total repositories found: \$(wc -l < ${env.REPO_LIST_FILE})"
                        """
                    }
                    archiveArtifacts artifacts: env.REPO_LIST_FILE, fingerprint: true
                }
            }
        }

        stage('2. Load State and Trigger Scans') {
            steps {
                    script {
                        def jobsToMonitor = []
                        def repoLines = readFile(env.REPO_LIST_FILE).trim().split('\\r?\\n')  

                        for (repoPathFull in repoLines) {
                            def repoPath = repoPathFull.trim()
                            if (repoPath == '') continue
                            
                            def uniqueStateFileName = "${repoPath.replace('/', '-')}.txt"
                            def uniqueStateFilePath = "${env.JFROG_STATE_PREFIX}${uniqueStateFileName}"
                            
                            def scanStatus = 'NEW'
                            def lastScannedCommit = ''
                            def currentLatestCommit = ''
                            
                            // Get the current latest commit ID for comparison
                            try {
                               currentLatestCommit = sh(returnStdout: true, script: "git ls-remote https://github.com/${repoPath}.git HEAD | awk '{print \$1}'").trim()
                            } catch (e) {
                               echo "WARNING: Failed to get latest commit for ${repoPath}. Skipping comparison."
                               currentLatestCommit = 'UNKNOWN'
                            }
                            
                            // Try to download and read the unique state file
                            try {
                                jf "rt dl ${env.JFROG_REPO}/${uniqueStateFilePath} ${uniqueStateFileName} --flat"
                                
                                def stateContent = readFile(uniqueStateFileName).trim()
                                def statusParts = stateContent.split(',')
                                
                                if (statusParts.size() >= 3) {
                                    lastScannedCommit = statusParts[1].trim()
                                    scanStatus = statusParts[2].trim()
                                }
                                sh "rm ${uniqueStateFileName}" 
                                
                            } catch (err) {
                                scanStatus = 'NEW'
                            }
                            
                            // --- Define Logic ---
                            def shouldScan = false
                            
                            if (scanStatus == 'NEW') {
                                shouldScan = true
                                echo "Scan required for ${repoPath}. Reason: NEW repository."
                            } else if (scanStatus == 'inprogress') {
                                shouldScan = false 
                                echo "Skipping scan for ${repoPath}. Reason: Already marked as 'inprogress' by another job."
                            } else if (scanStatus != 'completed') {
                                shouldScan = true
                                echo "Scan required for ${repoPath}. Reason: Previous status was '${scanStatus}' (requires retry)."
                            } else if (lastScannedCommit != currentLatestCommit && currentLatestCommit != 'UNKNOWN') {
                                shouldScan = true
                                echo "Scan required for ${repoPath}. Reason: Commit ID changed (${lastScannedCommit} -> ${currentLatestCommit})."
                            } else {
                                shouldScan = false
                                echo "Skipping scan for ${repoPath}. Status: completed, Commit: ${currentLatestCommit}."
                            }

                            if (shouldScan) {
                                def triggeredJob = build job: 'New_scanner', 
                                    parameters: [
                                        string(name: 'REPO_PATH', value: repoPath)
                                    ],
                                    wait: false

                                if (triggeredJob != null) {
                                    jobsToMonitor.add(triggeredJob)
                                }
                            }
                        }
                        

                        echo "Waiting for all ${jobsToMonitor.size()} scan jobs to complete..."
                    }
            }
        }
    }
}
