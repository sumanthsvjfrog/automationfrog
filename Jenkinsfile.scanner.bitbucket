// FROGBOT-REPO-SCANNER Pipeline Script

pipeline {
    agent { label 'ubuntu' } 
    tools { 
        jfrog 'psblr'
    }

    parameters {
        string(name: 'REPO_PATH', description: 'Repository full name (owner/repo)')
        string(name: 'BITBUCKET_SERVER_URL', description: 'Base URL for Bitbucket Server/Data Center.')
        string(name: 'GIT_BRANCH', description: 'The branch to clone and scan.')
        string(name: 'FROGBOT_VERSION', description: 'The Frogbot CLI version to install and run.')
    }

    environment {
        // --- JFrog State Configuration ---
        JFROG_REPO = 'frogbot-state'
        JFROG_STATE_PREFIX = 'state/repo-status/' 
        
        // --- Frogbot Configuration (Credentials MUST match Jenkins IDs) ---
        JF_GIT_PROVIDER = "bitbucketServer"
        JF_GIT_BASE_BRANCH = "${params.GIT_BRANCH}"
        JF_URL = credentials("JF_URL")
        JF_ACCESS_TOKEN = credentials("JF_ACCESS_TOKEN")
        JF_GIT_TOKEN = credentials("JF_BIT_TOKEN")
        JF_GIT_API_ENDPOINT = "${params.BITBUCKET_SERVER_URL}/rest"
        JF_BITBUCKETSERVER_URL = "${params.BITBUCKET_SERVER_URL}"
        JF_GIT_USERNAME = credentials("JF_BIT_USER")
        FROGBOT_VERSION = "${params.FROGBOT_VERSION}"
        
        // --- Dynamic Variables ---
        UNIQUE_STATE_FILE_NAME = "${params.REPO_PATH.replace('/', '-')}.txt"
        UNIQUE_STATE_FILE_PATH = "${env.JFROG_STATE_PREFIX}${env.UNIQUE_STATE_FILE_NAME}"
        //RESULTS_FILE_NAME = "${params.REPO_PATH.replace('/', '-')}-results.log"
        //RESULTS_FILE_PATH = "results/${env.RESULTS_FILE_NAME}"
        RESULTS_FILE_BASE = "${params.REPO_PATH.replace('/', '-')}" 
        RESULTS_FILE_PATH = "results/" // We'll construct the full name and path in the script block
    }

    stages {
        stage('Initialize State and Scan') {
            steps {
                 ws("workspace/New_scanner_${env.BUILD_NUMBER}") {
                    withCredentials([
                    string(credentialsId: 'JF_BIT_TOKEN', variable: 'BB_PAT'),
                ]) {
                    script {
                        def (projectKey, repoSlug) = params.REPO_PATH.split('/')
                        def repoUrl = "${env.JF_BITBUCKETSERVER_URL}/scm/${projectKey}/${repoSlug}.git"

                        env.JF_GIT_OWNER = projectKey
                        env.JF_GIT_REPO = repoSlug

                        env.LAST_GIT_COMMIT = sh(
                             script: """git -c http.extraheader="Authorization: Bearer \$BB_PAT" ls-remote ${repoUrl} HEAD | cut -f1""",
                             returnStdout: true
                        ).trim()
                        
                        env.NOW = sh(
                            script: "date -u +\"%Y-%m-%dT%H:%M:%SZ\"",
                            returnStdout: true
                        ).trim()

                        echo "Latest remote commit ID is: ${env.LAST_GIT_COMMIT}"
                        def shortCommitId = env.LAST_GIT_COMMIT.substring(0, 7)
                        def finalResultsFileName = "${env.RESULTS_FILE_BASE}-${shortCommitId}.log"

                        sh """
                        echo "${params.REPO_PATH},${env.LAST_GIT_COMMIT},inprogress,${now}" > ${env.UNIQUE_STATE_FILE_NAME}
                        """
                        jf "rt u ${env.UNIQUE_STATE_FILE_NAME} ${env.JFROG_REPO}/${env.UNIQUE_STATE_FILE_PATH} --flat"

                        // Install Frogbot if needed
                        sh """
                        FROGBOT_BIN="/usr/bin/frogbot"
                        REQUIRED_VERSION="${FROGBOT_VERSION}"
                        installfrog=no
                        # Check if Frogbot is installed
                        if [ -x "\$FROGBOT_BIN" ]; then
                            INSTALLED_VERSION="\$(\$FROGBOT_BIN --version 2>/dev/null | awk '{print \$NF}')"
                            echo "Frogbot found: version \${INSTALLED_VERSION}"
                            # Check version mismatches
                            if [ "\$INSTALLED_VERSION" = "\$REQUIRED_VERSION" ]; then
                                echo "Frogbot version matches (\$REQUIRED_VERSION). No installation needed"
                                installfrog=no
                            else
                                echo "Version mismatch! Installed: \$INSTALLED_VERSION, Required: \$REQUIRED_VERSION"
                                installfrog=yes
                            fi
                        else
                            installfrog=yes
                        fi
                        if [ \$installfrog = yes ];then
                            curl -fLg "https://releases.jfrog.io/artifactory/frogbot/v2/\${env.FROGBOT_VERSION}/getFrogbot.sh" | sh
                            chmod +x frogbot
                            sudo mv -f frogbot /usr/bin/frogbot
                            echo "Frogbot v\${REQUIRED_VERSION} installed successfully."
                        fi
                        """

                        sh """
                            echo "--- Scan started at ${now} ---" > ${env.RESULTS_FILE_NAME}
                            frogbot scan-repository 2>&1 | tee -a ${finalResultsFileName}
                        """
                        env.FINAL_RESULTS_FILE_NAME = finalResultsFileName
                    }
                }
            }
        }  
        }
    }
    
    // --- POST ACTIONS FOR STATE MANAGEMENT AND ARTIFACT ARCHIVAL ---
    post {
        success {
            ws("workspace/New_scanner_${env.BUILD_NUMBER}") {
            script {
                echo "Scan succeeded. Updating state to 'completed' and archiving results."
                
                // ---Upload Results Artifact---
                sh """
                echo "Archived detailed results to ${env.RESULTS_FILE_PATH}"
                """
                jf "rt u ${env.FINAL_RESULTS_FILE_NAME} ${env.JFROG_REPO}/${env.RESULTS_FILE_PATH}/${env.FINAL_RESULTS_FILE_NAME} --flat"
                
                // ---Update State File---
                sh """
                echo "${params.REPO_PATH},${env.LAST_GIT_COMMIT},completed,${env.NOW}" > ${env.UNIQUE_STATE_FILE_NAME}
                """
                jf "rt u ${env.UNIQUE_STATE_FILE_NAME} ${env.JFROG_REPO}/${env.UNIQUE_STATE_FILE_PATH} --flat"
            }
            }
        }
        
        failure {
            ws("workspace/New_scanner_${env.BUILD_NUMBER}") {
            script {
                def commitToLog = env.LAST_GIT_COMMIT ?: "UNKNOWN_FAILURE"
                echo "Scan FAILED. Updating state to 'failed' with Commit ID: ${commitToLog}."

                if (fileExists(env.RESULTS_FILE_NAME)) { 
                    sh """
                    echo "Archived failure log to ${env.RESULTS_FILE_PATH}"
                    """
                    jf "rt u ${env.FINAL_RESULTS_FILE_NAME} ${env.JFROG_REPO}/${env.RESULTS_FILE_PATH}/${env.FINAL_RESULTS_FILE_NAME} --flat"
                } else {
                    echo "WARNING: Results log file was not created; skipping upload."
                }
                
                sh """
                echo "${params.REPO_PATH},${commitToLog},failed,${env.NOW}" > ${env.UNIQUE_STATE_FILE_NAME}
                """
                jf "rt u ${env.UNIQUE_STATE_FILE_NAME} ${env.JFROG_REPO}/${env.UNIQUE_STATE_FILE_PATH} --flat"
            }
        }
        }
        
        aborted {
            ws("workspace/New_scanner_${env.BUILD_NUMBER}") {
             script {
                def commitToLog = env.LAST_GIT_COMMIT ?: "UNKNOWN_FAILURE"
                echo "Scan ABORTED. Updating state to 'failed'."

                if (fileExists(env.RESULTS_FILE_NAME)) { 
                    sh """
                    echo "Archived aborted log to ${env.RESULTS_FILE_PATH}"
                    """
                    jf "rt u ${env.FINAL_RESULTS_FILE_NAME} ${env.JFROG_REPO}/${env.RESULTS_FILE_PATH}/${env.FINAL_RESULTS_FILE_NAME} --flat"
                } else {
                    echo "WARNING: Results log file was not created; skipping upload."
                }
                
                sh """
                echo "${params.REPO_PATH},${commitToLog},failed,${env.NOW}" > ${env.UNIQUE_STATE_FILE_NAME}
                """
                jf "rt u ${env.UNIQUE_STATE_FILE_NAME} ${env.JFROG_REPO}/${env.UNIQUE_STATE_FILE_PATH} --flat"
            }
            }
        }
    }
}
